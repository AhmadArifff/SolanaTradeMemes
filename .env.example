# ==============================================================================
# Solana Trade Memes - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Solana Private RPC & Network Endpoints (Wajib untuk Anti-Rate Limit)
# ------------------------------------------------------------------------------
# Masukkan endpoint Private RPC (Helius / QuickNode / Triton)
NEXT_PUBLIC_SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY"
NEXT_PUBLIC_SOLANA_WSS_URL="wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY"
NEXT_PUBLIC_SOLANA_CLUSTER="mainnet-beta"

# Endpoint RPC cadangan (fallback jika RPC utama down)
NEXT_PUBLIC_FALLBACK_RPC_URL="https://solana-mainnet.g.alchemy.com/v2/YOUR_BACKUP_KEY"

# Opsional: Kunci API Helius untuk DAS / Priority Fee API
NEXT_PUBLIC_HELIUS_API_KEY="YOUR_HELIUS_API_KEY"

# ------------------------------------------------------------------------------
# 2. DEX Engine & Price Polling APIs
# ------------------------------------------------------------------------------
# Endpoint perakit transaksi unsigned PumpPortal
NEXT_PUBLIC_PUMPPORTAL_API_URL="https://pumpportal.fun/api/trade-local"

# Endpoint polling harga token real-time
NEXT_PUBLIC_DEXSCREENER_API_URL="https://api.dexscreener.com/latest/dex/tokens"

# ------------------------------------------------------------------------------
# 3. Trading Engine Defaults & Guardrails
# ------------------------------------------------------------------------------
# Default slippage dalam basis points (1000 = 10%)
NEXT_PUBLIC_DEFAULT_SLIPPAGE_BPS=1000

# Default Priority Fee dalam SOL (0.005 SOL)
NEXT_PUBLIC_DEFAULT_PRIORITY_FEE=0.005

# Default Compute Unit limit
NEXT_PUBLIC_COMPUTE_UNIT_LIMIT=200000

# Cadangan minimum SOL per dompet agar tidak habis total saat beli
NEXT_PUBLIC_RENT_EXEMPT_RESERVE=0.005

# ------------------------------------------------------------------------------
# 4. Polling Timers (Milidetik)
# ------------------------------------------------------------------------------
# Interval polling saat tab aktif (5 detik)
NEXT_PUBLIC_PRICE_POLL_INTERVAL_ACTIVE_MS=5000

# Interval polling saat tab tidak aktif / blur (30 detik)
NEXT_PUBLIC_PRICE_POLL_INTERVAL_BLUR_MS=30000

# ------------------------------------------------------------------------------
# 5. Cloud Sync Opsional (HANYA untuk Data Non-Sensitif seperti Watchlist)
# PERINGATAN: DILARANG KERAS menyimpan private key atau password di Supabase!
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
